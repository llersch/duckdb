# name: test/sql/headless_duck/errors.test
# description: Error handling for malformed headless_duck files
# group: [headless_duck]

require headless_duck

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_missing.hduck');
----
<REGEX>:IO Error:.*

statement ok
COPY (SELECT 'tiny'::BLOB) TO '{TEST_DIR}/headless_duck_tiny.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_tiny.hduck');
----
IO Error: headless_duck: file '{TEST_DIR}/headless_duck_tiny.hduck' is 4 bytes, needs at least 64

statement ok
COPY (SELECT repeat('x', 64)::BLOB) TO '{TEST_DIR}/headless_duck_bad_leading_magic.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_bad_leading_magic.hduck');
----
IO Error: headless_duck: bad leading magic in {TEST_DIR}/headless_duck_bad_leading_magic.hduck

statement ok
COPY (
	SELECT ('HDUCK1\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00'::BLOB || repeat('\x00', 48)::BLOB)
) TO '{TEST_DIR}/headless_duck_unsupported_version.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_unsupported_version.hduck');
----
IO Error: headless_duck: unsupported format_version 2

statement ok
COPY (
	SELECT ('HDUCK1\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00'::BLOB || repeat('\x00', 48)::BLOB)
) TO '{TEST_DIR}/headless_duck_nonzero_flags.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_nonzero_flags.hduck');
----
IO Error: headless_duck: reserved header flags must be 0

statement ok
COPY (
	SELECT ('HDUCK1\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00'::BLOB || repeat('\x00', 48)::BLOB)
) TO '{TEST_DIR}/headless_duck_bad_trailing_magic.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_bad_trailing_magic.hduck');
----
IO Error: headless_duck: bad trailing magic in {TEST_DIR}/headless_duck_bad_trailing_magic.hduck

statement ok
COPY (
	SELECT (
		'HDUCK1\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00'::BLOB ||
		repeat('\x00', 16)::BLOB ||
		'\x01\x00\x00\x00\x00\x00\x00\x00'::BLOB ||
		repeat('\x00', 16)::BLOB ||
		'HDUCK1\x00\x00'::BLOB
	)
) TO '{TEST_DIR}/headless_duck_nonzero_metadata_checksum.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_nonzero_metadata_checksum.hduck');
----
IO Error: headless_duck: metadata_checksum is reserved and must be 0

statement ok
COPY (
	SELECT (
		'HDUCK1\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00'::BLOB ||
		'\xE8\x03\x00\x00\x00\x00\x00\x00'::BLOB ||
		'\xE8\x03\x00\x00\x00\x00\x00\x00'::BLOB ||
		repeat('\x00', 16)::BLOB ||
		'\x00\x00\x04\x00\x00\x00\x00\x00'::BLOB ||
		'HDUCK1\x00\x00'::BLOB
	)
) TO '{TEST_DIR}/headless_duck_footer_outside_file.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_footer_outside_file.hduck');
----
IO Error: headless_duck: footer points outside the file

statement ok
CREATE TABLE hduck_error_source AS SELECT 42::INTEGER AS i;

statement ok
COPY hduck_error_source TO '{TEST_DIR}/headless_duck_valid_for_truncate.hduck' (FORMAT headless_duck);

statement ok
COPY (
	SELECT content[:63] FROM read_blob('{TEST_DIR}/headless_duck_valid_for_truncate.hduck')
) TO '{TEST_DIR}/headless_duck_truncated.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_truncated.hduck');
----
IO Error: headless_duck: file '{TEST_DIR}/headless_duck_truncated.hduck' is 63 bytes, needs at least 64

# The simple one-column file has a 73-byte metadata section followed by a 48-byte footer.

statement ok
COPY (
	WITH original AS (
		SELECT content, size, size - 121 AS metadata_start
		FROM read_blob('{TEST_DIR}/headless_duck_valid_for_truncate.hduck')
	)
	SELECT
		array_slice(content, 1, metadata_start + 2) ||
		'\x02'::BLOB ||
		array_slice(content, metadata_start + 4, size)
	FROM original
) TO '{TEST_DIR}/headless_duck_bad_metadata_column_count.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_bad_metadata_column_count.hduck');
----
IO Error: headless_duck: metadata column count mismatch

statement ok
COPY (
	SELECT
		array_slice(content, 1, size - 40) ||
		'\x0A'::BLOB ||
		array_slice(content, size - 38, size)
	FROM read_blob('{TEST_DIR}/headless_duck_valid_for_truncate.hduck')
) TO '{TEST_DIR}/headless_duck_truncated_metadata_section.hduck' (FORMAT BLOB);

statement error
SELECT * FROM headlessduck_file_stats('{TEST_DIR}/headless_duck_truncated_metadata_section.hduck');
----
<REGEX>:IO Error: headless_duck: failed to read metadata:.*

statement ok
COPY (
	WITH original AS (
		SELECT content, size, size - 121 AS metadata_start
		FROM read_blob('{TEST_DIR}/headless_duck_valid_for_truncate.hduck')
	)
	SELECT
		array_slice(content, 1, metadata_start + 47) ||
		'\x02'::BLOB ||
		array_slice(content, metadata_start + 49, size)
	FROM original
) TO '{TEST_DIR}/headless_duck_bad_metadata_manager.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_bad_metadata_manager.hduck');
----
<REGEX>:IO Error: headless_duck: failed to read metadata manager:.*

statement ok
COPY (
	WITH original AS (
		SELECT content, size, size - 121 AS metadata_start
		FROM read_blob('{TEST_DIR}/headless_duck_valid_for_truncate.hduck')
	), shortened AS (
		SELECT
			array_slice(content, 1, metadata_start + 30) ||
			'\x00'::BLOB ||
			array_slice(content, metadata_start + 37, size) AS content,
			size - 5 AS size
		FROM original
	)
	SELECT
		array_slice(content, 1, size - 40) ||
		'\x44'::BLOB ||
		array_slice(content, size - 38, size)
	FROM shortened
) TO '{TEST_DIR}/headless_duck_row_group_column_count_mismatch.hduck' (FORMAT BLOB);

statement error
SELECT * FROM headlessduck_file_stats('{TEST_DIR}/headless_duck_row_group_column_count_mismatch.hduck');
----
IO Error: headless_duck: row group column count mismatch

statement ok
COPY (
	WITH original AS (
		SELECT content, size, size - 121 AS metadata_start
		FROM read_blob('{TEST_DIR}/headless_duck_valid_for_truncate.hduck')
	)
	SELECT
		array_slice(content, 1, metadata_start + 33) ||
		'\x7F'::BLOB ||
		array_slice(content, metadata_start + 35, size)
	FROM original
) TO '{TEST_DIR}/headless_duck_bad_column_metadata.hduck' (FORMAT BLOB);

statement error
SELECT * FROM read_headlessduck('{TEST_DIR}/headless_duck_bad_column_metadata.hduck');
----
<REGEX>:IO Error: headless_duck: failed to read column metadata:.*

statement error
SELECT * FROM headlessduck_file_stats('{TEST_DIR}/headless_duck_bad_column_metadata.hduck');
----
<REGEX>:IO Error: headless_duck: failed to read column metadata:.*
