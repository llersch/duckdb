# name: test/sql/headless_duck/written_statistics.test
# description: RETURN_STATS support for headless_duck COPY writes
# group: [headless_duck]

require headless_duck

query IIIIII
COPY (
	SELECT
		i,
		CASE WHEN i % 2 = 0 THEN NULL ELSE i END AS maybe_i,
		'key_' || i::VARCHAR AS s
	FROM range(5) t(i)
) TO '{TEST_DIR}/headless_duck_written_stats.hduck' (FORMAT headless_duck, RETURN_STATS);
----
<REGEX>:.*headless_duck_written_stats.hduck	5	<REGEX>:\d+	48	{i={max=4, min=0, null_count=0, num_values=5}, maybe_i={max=3, min=1, num_values=5}, s={max=key_4, min=key_0, null_count=0, num_values=5}}	NULL

query III
SELECT count(*), min(i), max(s) FROM read_headlessduck('{TEST_DIR}/headless_duck_written_stats.hduck');
----
5	0	key_4

query IIIIII
COPY (
	SELECT 1::INTEGER AS i WHERE false
) TO '{TEST_DIR}/headless_duck_empty_written_stats.hduck' (FORMAT headless_duck, RETURN_STATS);
----
<REGEX>:.*headless_duck_empty_written_stats.hduck	0	<REGEX>:\d+	48	{i={null_count=0, num_values=0}}	NULL
