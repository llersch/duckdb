# name: test/sql/headless_duck/filter_pushdown.test
# description: Filter pushdown for headless_duck scans
# group: [headless_duck]

require headless_duck

require 64bit

statement ok
CREATE TABLE hduck_filter_source AS
SELECT
	i::INTEGER AS id,
	'row_' || i::VARCHAR AS payload,
	CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END AS category,
	DATE '2020-01-01' + (i % 365)::INTEGER AS shipdate
FROM range(150000) tbl(i);

statement ok
COPY hduck_filter_source TO '{TEST_DIR}/headless_duck_filter.hduck' (FORMAT headless_duck);

query T
SELECT payload
FROM read_headlessduck('{TEST_DIR}/headless_duck_filter.hduck')
WHERE id = 149999;
----
row_149999

query T
SELECT payload
FROM read_headlessduck('{TEST_DIR}/headless_duck_filter.hduck')
WHERE id BETWEEN 149997 AND 149999
ORDER BY payload;
----
row_149997
row_149998
row_149999

query I
SELECT count(*)
FROM read_headlessduck('{TEST_DIR}/headless_duck_filter.hduck')
WHERE category = 'odd' AND shipdate >= DATE '2020-06-01';
----
43764

statement ok
CREATE TABLE hduck_filter_cache_source AS
SELECT
	i::INTEGER AS a,
	(i % 3)::INTEGER AS b,
	(i % 5)::INTEGER AS c,
	(i % 7)::INTEGER AS d
FROM range(10000) tbl(i);

statement ok
COPY hduck_filter_cache_source TO '{TEST_DIR}/headless_duck_filter_cache.hduck' (FORMAT headless_duck);

query I
SELECT sum(a + b + c + d)::BIGINT
FROM read_headlessduck('{TEST_DIR}/headless_duck_filter_cache.hduck');
----
50054993

query I
SELECT count(*)
FROM read_headlessduck('{TEST_DIR}/headless_duck_filter_cache.hduck')
WHERE d = 3 AND b = 1 AND c < 4;
----
381

statement ok
PRAGMA explain_output = 'PHYSICAL_ONLY';

query II
EXPLAIN SELECT payload FROM read_headlessduck('{TEST_DIR}/headless_duck_filter.hduck') WHERE id = 149999;
----
physical_plan	<REGEX>:(?s)^[^F]*READ_HEADLESSDUCK.*Filters:.*\(id = 149999\).*
