# name: test/sql/headless_duck/filter_pushdown.test
# description: Filter pushdown for headless_duck scans
# group: [headless_duck]

require headless_duck

require 64bit

statement ok
CREATE TABLE hduck_filter_source AS
SELECT
	i::INTEGER AS id,
	'row_' || i::VARCHAR AS payload,
	CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END AS category,
	DATE '2020-01-01' + (i % 365)::INTEGER AS shipdate
FROM range(150000) tbl(i);

statement ok
COPY hduck_filter_source TO '{TEST_DIR}/headless_duck_filter.hduck' (FORMAT headless_duck);

query T
SELECT payload
FROM read_headlessduck('{TEST_DIR}/headless_duck_filter.hduck')
WHERE id = 149999;
----
row_149999

query T
SELECT payload
FROM read_headlessduck('{TEST_DIR}/headless_duck_filter.hduck')
WHERE id BETWEEN 149997 AND 149999
ORDER BY payload;
----
row_149997
row_149998
row_149999

query I
SELECT count(*)
FROM read_headlessduck('{TEST_DIR}/headless_duck_filter.hduck')
WHERE category = 'odd' AND shipdate >= DATE '2020-06-01';
----
43764

statement ok
PRAGMA explain_output = 'PHYSICAL_ONLY';

query II
EXPLAIN SELECT payload FROM read_headlessduck('{TEST_DIR}/headless_duck_filter.hduck') WHERE id = 149999;
----
physical_plan	<REGEX>:(?s).*FILTER.*\(id = 149999\).*READ_HEADLESSDUCK.*Filters:.*optional: \(id = 149999\).*
